@echo off
cd /d "%~dp0"


echo This script will set up the mlagents python env for this machine. If you don't want to do this, close this window or interrupt with CTRL-C.
pause
echo.

@echo on

py -3.10 --version >nul 2>&1
if errorlevel 1 (
    echo Python 3.10 is required. Install it, then run this script again.
    exit /b 1
)

if not exist "mlagents-env\Scripts\python.exe" (
    py -3.10 -m venv mlagents-env
    if errorlevel 1 goto :error
)

call "mlagents-env\Scripts\activate.bat"
if errorlevel 1 goto :error

python -m pip install --upgrade pip
if errorlevel 1 goto :error

python -m pip install "setuptools<81" wheel
if errorlevel 1 goto :error

python -m pip install mlagents
if errorlevel 1 goto :error

python -m pip install "setuptools<81"
if errorlevel 1 goto :error

python -m pip install "torch~=2.2.1"
if errorlevel 1 goto :error

echo.
echo Environment setup complete. This Command Prompt is activated.
echo.
goto :finish

:error
echo.
echo Environment setup failed. See the error above.
pause
exit /b 1

:finish
cmd /k

